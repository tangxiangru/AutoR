__pycache__/
*.pyc
.DS_Store
runs/
.tmp/
AGENTS.md
AGENTS.local/
.codex
.autor/
configs/diagram_config.yaml
# docs/ holds published documentation plus local scratch notes. Ignore the
# directory contents by default, then allow every markdown page back in --
# without the `!docs/*.md` line a newly added doc is silently untracked.
docs/*
!docs/*.md
!docs/ui-design/
!docs/ui-design/**
docs/ui-design/.DS_Store
# Paper material. Same shape as ui-design above, and for the same reason the
# comment gives: `!docs/*.md` reaches files directly under docs/ and not a
# subdirectory, so a page added here is silently untracked without these two lines.
!docs/iclr/
!docs/iclr/**
examples/
agentspace/
assets/paper_gallery_source/
project/

# Credentials. The judge key lives outside the tree by default (see
# tools/score_rcb_run.py DEFAULT_KEY_FILE); this is belt and braces for a copy
# that lands here by accident.
api.txt
*.key
.env

# The FrontierScience-Research split. Pinned by digest in src/frontierscience.py and never
# committed: its dataset card carries a canary GUID asking that the text stay out of
# crawlable corpora, and this repository is one. The reader defaults to ~/.cache, so these
# two lines are for a copy that lands here anyway -- and for the judge responses, which
# quote rubric items back verbatim while they reason.
frontierscience/
research_test.jsonl
